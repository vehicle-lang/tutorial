---
import "tufte-css/tufte.min.css";
import { Image } from 'astro:assets';
import friendlyPurpleOnLaptop from "../assets/images/software-purple-2500x2500.png";
import CopyOnClick from "../components/CopyOnClick.astro";
import { pageTitle } from "../site";
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <article>
      <header>
        <p class="banner-title">
          <Image alt="A friendly purple robot on their laptop." src={friendlyPurpleOnLaptop} />
          <a href={base}>{pageTitle}</a>
        </p>
      </header>
      <h1>{frontmatter.title}</h1>
      {
        frontmatter?.subtitle && (
          <span class="subtitle">{frontmatter?.subtitle}</span>
        )
      }
      <slot />
    </article>
  </body>
</html>

<!-- Add "Copy on Click" button to code blocks. -->
<CopyOnClick />

<!-- Client-side script to switch tabs -->
<script>
  function setupTabs() {
    document.querySelectorAll('.tabs-container').forEach((container) => {
      const buttons = container.querySelectorAll('.tab-button');
      const contents = container.querySelectorAll('.tabs-content > *');

      // Hide all but active tab or first content element
      contents.forEach((content, idx) => {
        const button = buttons[idx];
        if (button && button.classList.contains('active')) {
          (content as HTMLElement).style.display = 'block';
        } else if (idx === 0 && !Array.from(buttons).some(b => b.classList.contains('active'))) {
          (content as HTMLElement).style.display = 'block';
          buttons[0]?.classList.add('active');
        } else {
          (content as HTMLElement).style.display = 'none';
        }
      });

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = parseInt(button.getAttribute('data-index') || '0', 10);

          buttons.forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');

          contents.forEach((content, idx) => {
            (content as HTMLElement).style.display = idx === index ? 'block' : 'none';
          });
        });
      });
    });
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>

<style is:global>
  /* Fix Tufte CSS */
  @import "../assets/css/tufte-fixes.css";

  /* Add Prism Themes */
  @import "prismjs/themes/prism-solarizedlight.min.css"
    screen;
  @import "prismjs/themes/prism-tomorrow.min.css"
    screen and (prefers-color-scheme: dark);

  /* Add local style sheets */
  @import "../assets/css/banner.css";
  @import "../assets/css/chapter-nav.css";
  @import "../assets/css/heading-anchor.css";
  @import "../assets/css/marginnote.css";
  @import "../assets/css/marginnote-bibliography.css";
</style>
